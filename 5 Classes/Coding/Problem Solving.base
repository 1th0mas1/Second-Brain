views:
  - type: table
    name: Table
    filters:
      and:
        - Class == ["Problem Solving"]
    order:
      - file.name
      - file.folder
      - Topics
      - tags
    sort:
      - property: file.folder
        direction: ASC
      - property: Topics
        direction: ASC
    columnSize:
      file.name: 400
      file.folder: 251
